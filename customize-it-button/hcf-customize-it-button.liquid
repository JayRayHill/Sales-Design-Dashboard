{%- comment -%}
  Customize It — frosted liquid-glass CTA for product pages.

  A slow-turning current of brand color (Roasted dark -> Roasted -> Brew ->
  Iced light -> Iced dark) drifts behind a frosted glass pane. On hover or
  press the frost thins and the color surges through, with a specular sweep.
  Pure CSS — no images, no JS, no apps.

  Trigger logic is unchanged from the old button: renders only when the
  product has the custom.customize_it_product metafield, and links to that
  product.

  INSTALL
  1. Save this file as snippets/hcf-customize-it-button.liquid
  2. In snippets/product-template.liquid, find the old block (search for
     "hcf-customize-it-container", inside the buy_buttons case) and replace
     the whole {% if metafield_value %} ... {% endif %} block with:

       {% render 'hcf-customize-it-button', product: product %}

  TUNING (CSS variables on .hcf-glass-btn below)
    --hcf-aura-speed  rotation speed of the color current (default 10s)
    --hcf-frost       frost opacity at rest, 0-1 (default 0.62)
    --hcf-radius      corner radius (default 12px)
    --hcf-label       label text color (default Ink #161310)

  Optional finish variants — add a class next to hcf-glass-btn:
    hcf-glass-btn--ring     color shows as a crisp moving border ring
    hcf-glass-btn--molten   thinner frost, richer color at rest

  Optional color ranges — add one of these to change the current's palette
  (default is the full brand run: Roasted -> Brew -> Iced):
    hcf-glass-btn--roasted  orange only
    hcf-glass-btn--brew     yellow only
    hcf-glass-btn--iced     blue only
    hcf-glass-btn--sunrise  orange + yellow, no cool tones

  Optional texture — the character of the glass (default is frosted):
    hcf-glass-btn--satin    semi-sheer middle ground: color present at
                            rest but gently hazed, soft top sheen
    hcf-glass-btn--liquid   clear "liquid glass": thin wet film, vivid
                            color, permanent gloss highlight

  Hover behavior matches the Canopy theme's default buttons: a 104deg
  diagonal wipe (background-position slide, 0.4s ease-out) — here the
  frost wipes away to reveal the color current.

  Optional depth — how far the glass steps off the page (default is flush):
    hcf-glass-btn--raised   layered shadow, top-lit pane, higher hover lift
    hcf-glass-btn--domed    3D lens: glare cap, beveled edge, deep shadow,
                            presses down on click
{%- endcomment -%}

{%- assign customize_handle = product.metafields.custom.customize_it_product -%}
{%- if customize_handle -%}
  {%- assign related_product = all_products[customize_handle] -%}
  {%- if related_product -%}
    <div class="hcf-customize-it-container">
      <a
        href="{{ related_product.url }}"
        class="hcf-glass-btn"
        aria-label="Customize {{ product.title | escape }}"
      >
        <span class="hcf-glass-btn__aura" aria-hidden="true"></span>
        <span class="hcf-glass-btn__frost" aria-hidden="true"></span>
        <span class="hcf-glass-btn__shine" aria-hidden="true"></span>
        <span class="hcf-glass-btn__label">Customize It</span>
      </a>
    </div>

    {% style %}
      .hcf-customize-it-container { margin: 14px 0; }

      .hcf-glass-btn {
        --hcf-aura-speed: 10s;
        --hcf-frost: 0.62;
        --hcf-radius: 12px;
        --hcf-label: #161310; /* Ink */
        /* Color current — Full brand by default */
        --hcf-c1: #BC5713;
        --hcf-c2: #FD822C;
        --hcf-c3: #FFCB1F;
        --hcf-c4: #9FDCED;
        --hcf-c5: #2A7A8A;
        --hcf-glow-rest: rgba(188, 87, 19, 0.40);
        --hcf-glow-a: rgba(253, 130, 44, 0.55);
        --hcf-glow-b: rgba(42, 122, 138, 0.35);
        --hcf-tint: rgba(188, 87, 19, 0.25);

        position: relative;
        z-index: 0;
        isolation: isolate;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 58px;
        padding: 16px 32px;
        border-radius: var(--hcf-radius);
        overflow: hidden;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-weight: 700;
        font-size: 15px;
        color: var(--hcf-label);
        text-shadow: 0 1px 0 rgba(255, 255, 255, 0.4);
        -webkit-tap-highlight-color: transparent;
        cursor: pointer;
        box-shadow:
          0 1px 3px rgba(22, 19, 16, 0.12),
          0 10px 26px -14px var(--hcf-glow-rest);
        transition: transform 0.35s ease, box-shadow 0.35s ease;
      }
      .hcf-glass-btn:hover { text-decoration: none; }

      /* Slow-turning current of brand color, blurred into a liquid wash */
      .hcf-glass-btn__aura {
        position: absolute;
        z-index: -2;
        left: 50%;
        top: 50%;
        width: max(170%, 480px);
        aspect-ratio: 1;
        translate: -50% -50%;
        border-radius: 50%;
        background: conic-gradient(
          from 20deg,
          var(--hcf-c1),
          var(--hcf-c2),
          var(--hcf-c3),
          var(--hcf-c4),
          var(--hcf-c5),
          var(--hcf-c1)
        );
        filter: blur(26px) saturate(1.05);
        animation: hcf-aura-turn var(--hcf-aura-speed) linear infinite;
        transition: filter 0.45s ease;
      }
      @keyframes hcf-aura-turn { to { transform: rotate(1turn); } }

      /* Frosted glass pane sitting on top of the color current */
      .hcf-glass-btn__frost {
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        /* Canopy-style 104° wipe: oversized two-stop gradient; hover slides it
           so the frost wipes away with the same angled sweep as theme buttons */
        background: linear-gradient(
            104deg,
            rgba(255, 255, 255, calc(var(--hcf-frost) - 0.52)) 60%,
            rgba(255, 255, 255, var(--hcf-frost)) 60%
          )
          no-repeat 100% 100%;
        background-size: 300% 100%;
        -webkit-backdrop-filter: blur(14px) saturate(1.35);
        backdrop-filter: blur(14px) saturate(1.35);
        border: 1px solid rgba(255, 255, 255, 0.72);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.9),
          inset 0 -10px 24px -14px var(--hcf-tint);
        transition: background-position 0.4s ease-out;
      }

      /* Specular sweep across the glass on hover */
      .hcf-glass-btn__shine {
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: inherit;
        background: linear-gradient(105deg, transparent 42%, rgba(255, 255, 255, 0.5) 50%, transparent 58%);
        transform: translateX(-130%);
        transition: transform 0.8s ease;
        pointer-events: none;
      }

      .hcf-glass-btn__label {
        position: relative;
        z-index: 2;
      }

      @media (hover: hover) {
        /* Pure Canopy hover: the wipe and nothing else — no lift, no glow
           change, no sweep. One motion, one timing, same as theme buttons. */
        .hcf-glass-btn:hover .hcf-glass-btn__frost {
          background-position: 0 100%;
        }
      }
      /* On touch, a press gives the same wipe */
      .hcf-glass-btn:active .hcf-glass-btn__frost {
        background-position: 0 100%;
      }
      .hcf-glass-btn:active { transform: translateY(0) scale(0.99); }
      .hcf-glass-btn:focus-visible { outline: 2px solid #FD822C; outline-offset: 3px; }

      /* Variant: Prism Ring — color shows as a crisp moving border ring */
      .hcf-glass-btn--ring { --hcf-frost: 0.9; }
      .hcf-glass-btn--ring .hcf-glass-btn__aura { filter: blur(8px) saturate(1.15); }
      .hcf-glass-btn--ring .hcf-glass-btn__frost {
        inset: 2.5px;
        border-radius: calc(var(--hcf-radius) - 2.5px);
      }

      /* Variant: Molten — thinner frost, richer color at rest */
      .hcf-glass-btn--molten { --hcf-frost: 0.40; }
      .hcf-glass-btn--molten .hcf-glass-btn__aura { filter: blur(24px) saturate(1.25); }

      /* Color ranges — swap the current's palette with one class */
      .hcf-glass-btn--roasted {
        --hcf-c1: #BC5713; --hcf-c2: #FD822C; --hcf-c3: #FFCCA9; --hcf-c4: #FD822C; --hcf-c5: #BC5713;
        --hcf-glow-rest: rgba(188, 87, 19, 0.40);
        --hcf-glow-a: rgba(253, 130, 44, 0.55);
        --hcf-glow-b: rgba(188, 87, 19, 0.30);
        --hcf-tint: rgba(188, 87, 19, 0.25);
      }
      .hcf-glass-btn--brew {
        --hcf-c1: #D8A105; --hcf-c2: #FFCB1F; --hcf-c3: #FFEDCA; --hcf-c4: #FFCB1F; --hcf-c5: #D8A105;
        --hcf-glow-rest: rgba(216, 161, 5, 0.40);
        --hcf-glow-a: rgba(255, 203, 31, 0.60);
        --hcf-glow-b: rgba(216, 161, 5, 0.35);
        --hcf-tint: rgba(216, 161, 5, 0.25);
      }
      .hcf-glass-btn--iced {
        --hcf-c1: #2A7A8A; --hcf-c2: #9FDCED; --hcf-c3: #CFF0F8; --hcf-c4: #9FDCED; --hcf-c5: #2A7A8A;
        --hcf-glow-rest: rgba(42, 122, 138, 0.40);
        --hcf-glow-a: rgba(159, 220, 237, 0.65);
        --hcf-glow-b: rgba(42, 122, 138, 0.40);
        --hcf-tint: rgba(42, 122, 138, 0.25);
      }
      .hcf-glass-btn--sunrise {
        --hcf-c1: #BC5713; --hcf-c2: #FD822C; --hcf-c3: #FFCB1F; --hcf-c4: #FFEDCA; --hcf-c5: #FD822C;
        --hcf-glow-rest: rgba(188, 87, 19, 0.40);
        --hcf-glow-a: rgba(253, 130, 44, 0.55);
        --hcf-glow-b: rgba(255, 203, 31, 0.40);
        --hcf-tint: rgba(188, 87, 19, 0.25);
      }

      /* Texture: Satin — halfway between frosted and liquid glass */
      .hcf-glass-btn--satin { --hcf-frost: 0.45; }
      .hcf-glass-btn--satin .hcf-glass-btn__aura { filter: blur(22px) saturate(1.12); }
      .hcf-glass-btn--satin .hcf-glass-btn__frost {
        -webkit-backdrop-filter: blur(9px) saturate(1.4);
        backdrop-filter: blur(9px) saturate(1.4);
        border: 1px solid rgba(255, 255, 255, 0.78);
      }
      .hcf-glass-btn--satin::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: inherit;
        background: linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.30),
          rgba(255, 255, 255, 0.05) 40%,
          rgba(255, 255, 255, 0) 60%
        );
        pointer-events: none;
      }
      .hcf-glass-btn--satin .hcf-glass-btn__label { text-shadow: 0 1px 1px rgba(255, 255, 255, 0.45); }

      /* Texture — Frosted (default) vs Liquid glass: clear, wet, vivid */
      .hcf-glass-btn--liquid { --hcf-frost: 0.22; }
      .hcf-glass-btn--liquid .hcf-glass-btn__aura {
        filter: blur(18px) saturate(1.2);
      }
      .hcf-glass-btn--liquid .hcf-glass-btn__frost {
        -webkit-backdrop-filter: blur(4px) saturate(1.5);
        backdrop-filter: blur(4px) saturate(1.5);
        border: 1px solid rgba(255, 255, 255, 0.85);
        box-shadow:
          inset 0 1px 1px rgba(255, 255, 255, 0.95),
          inset 0 -1px 1px rgba(255, 255, 255, 0.35),
          inset 0 0 18px rgba(255, 255, 255, 0.28);
      }
      /* Permanent wet gloss film over the clear glass */
      .hcf-glass-btn--liquid::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: inherit;
        background: linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.50),
          rgba(255, 255, 255, 0.08) 38%,
          rgba(255, 255, 255, 0) 55%,
          rgba(255, 255, 255, 0.18) 92%
        );
        pointer-events: none;
      }
      .hcf-glass-btn--liquid .hcf-glass-btn__label {
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.55);
      }

      /* Depth — how far the glass steps off the page. Default is Flush. */

      /* Raised: layered shadow + graded pane, lifts higher on hover */
      .hcf-glass-btn--raised,
      .hcf-glass-btn--domed {
        box-shadow:
          0 1px 2px rgba(22, 19, 16, 0.10),
          0 6px 12px -4px rgba(22, 19, 16, 0.12),
          0 16px 32px -14px var(--hcf-glow-rest);
      }
      .hcf-glass-btn--raised .hcf-glass-btn__frost::before,
      .hcf-glass-btn--domed .hcf-glass-btn__frost::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.20),
          rgba(255, 255, 255, 0) 55%,
          rgba(22, 19, 16, 0.05)
        );
        pointer-events: none;
      }

      /* Domed: curved glare cap, beveled edge, deep stacked shadow */
      .hcf-glass-btn--domed {
        box-shadow:
          0 1px 1px rgba(22, 19, 16, 0.12),
          0 4px 8px -2px rgba(22, 19, 16, 0.14),
          0 16px 30px -10px var(--hcf-glow-rest),
          0 30px 50px -22px rgba(22, 19, 16, 0.28);
      }
      .hcf-glass-btn--domed::before {
        content: "";
        position: absolute;
        left: 4%;
        right: 4%;
        top: 2px;
        height: 48%;
        z-index: 1;
        border-radius: calc(var(--hcf-radius) - 2px) calc(var(--hcf-radius) - 2px) 50% 50%;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0));
        pointer-events: none;
      }
      .hcf-glass-btn--domed .hcf-glass-btn__frost {
        box-shadow:
          inset 0 2px 2px rgba(255, 255, 255, 0.95),
          inset 0 -3px 6px rgba(22, 19, 16, 0.15),
          inset 0 -14px 28px -12px var(--hcf-tint);
      }
      @media (hover: hover) {
        .hcf-glass-btn--raised:hover {
          transform: translateY(-3px);
          box-shadow:
            0 2px 4px rgba(22, 19, 16, 0.08),
            0 10px 18px -6px rgba(22, 19, 16, 0.14),
            0 24px 44px -16px var(--hcf-glow-a),
            0 10px 26px -12px var(--hcf-glow-b);
        }
        .hcf-glass-btn--domed:hover {
          transform: translateY(-4px);
          box-shadow:
            0 2px 3px rgba(22, 19, 16, 0.10),
            0 8px 14px -4px rgba(22, 19, 16, 0.16),
            0 26px 46px -14px var(--hcf-glow-a),
            0 40px 64px -26px var(--hcf-glow-b);
        }
      }
      .hcf-glass-btn--domed:active {
        transform: translateY(1px) scale(0.985);
      }

      /* Fallback for browsers without backdrop-filter (rare) */
      @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .hcf-glass-btn { --hcf-frost: 0.85; }
      }

      @media (prefers-reduced-motion: reduce) {
        .hcf-glass-btn__aura { animation: none; }
        .hcf-glass-btn__shine { display: none; }
        .hcf-glass-btn,
        .hcf-glass-btn__frost { transition: none; }
      }
    {% endstyle %}
  {%- endif -%}
{%- endif -%}
